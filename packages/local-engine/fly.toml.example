# Fly.io deployment config example for Agentic WebSocket Relay Server
app = "agentic-relay-example"
primary_region = "iad"

[build]
  dockerfile = "packages/local-engine/Dockerfile.relay"

[env]
  AGENTIC_RELAY_PORT = "3848"
  NODE_ENV = "production"

[[services]]
  protocol = "tcp"
  internal_schema = "default"
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 80
    handlers = ["http"]
    force_https = true

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

  [services.concurrency]
    type = "connections"
    hard_limit = 5000
    soft_limit = 4000

  [[services.tcp_checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "5s"
