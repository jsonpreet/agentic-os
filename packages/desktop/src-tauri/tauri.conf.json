{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Desktop",
  "version": "0.1.0",
  "identifier": "com.agentic.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @agentic/local-engine build && pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentic Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "visible": true,
        "focus": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../local-engine/dist/bridge.js": "engine/bridge.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
